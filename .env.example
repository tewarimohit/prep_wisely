# Database
# Get this from your managed PostgreSQL provider (e.g., Neon, Supabase, Railway)
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/prep_wisely"

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# AI Service (Optional - app works without it)
# Get from OpenAI or compatible API provider
AI_API_KEY="your-openai-api-key"
AI_MODEL="gpt-4o-mini"
AI_API_URL="https://api.openai.com/v1/chat/completions"

# Note: TEST_USER_ID is deprecated - use NextAuth sessions instead
